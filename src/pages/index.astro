---
import { getEntry } from 'astro:content';
import SiteLayout from '../layouts/SiteLayout.astro';
import FilmLink from '../components/FilmLink.astro';
import FilmPreview from '../components/FilmPreview.astro';
import SpotlightFormats from '../components/SpotlightFormats.astro';
import Poster from '../components/Poster.astro';
import { products, homepageProductIds, featuredFilm } from '../data/films';

const premiere = await getEntry('premieres', 'mansfield-2026');
const date = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' });
---

<SiteLayout>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-media">
      <picture>
        <source media="(max-width: 680px)" srcset="/media/mansfield-team-small.webp" />
        <img src="/media/mansfield-team.webp" width="1440" height="810" alt="" fetchpriority="high" />
      </picture>
    </div>
    <div class="shell hero-inner">
      <div class="hero-copy">
        <p class="eyebrow"><span class="dot"></span> A film studio for teams and clubs</p>
        <h1 id="hero-title">We know they’re heroes, so let’s make their <em>movie.</em></h1>
        <p class="hero-deck">Cinematic season films, custom movie posters, and a premiere night for the people who lived it.</p>
        <div class="actions">
          <FilmLink {...featuredFilm} productName="Season Story" class="button button-primary"><span class="play" aria-hidden="true"></span>Watch the Film <span class="sr-only">{featuredFilm.title} ({featuredFilm.year})</span></FilmLink>
          <a class="button button-outline" href="#project">Start a Project <span aria-hidden="true">↗</span></a>
        </div>
      </div>
      <div class="hero-credit"><span>2026 PRODUCTION STILL</span><span>Mansfield Girls Soccer</span></div>
    </div>
  </section>

  <section class="section shell films-section" id="films" aria-labelledby="films-title">
    <header class="section-head">
      <div>
        <p class="eyebrow"><span class="dot"></span> 01 / Team films</p>
        <h2 id="films-title">The season.<br /><em>Cut like a movie.</em></h2>
      </div>
      <p>Give future players a feel for the team they could join. Give the players already in the room a night to remember.</p>
    </header>

    <div class="home-film-grid">
      {homepageProductIds.map((id) => {
        const product = products[id];
        const example = product.examples[0];
        return (
          <article class="film">
            <FilmPreview example={example} productName={product.name} />
            <p class="eyebrow">{product.name} · {example.year}</p>
            <h3>{example.title}</h3>
            <p>{product.description}</p>
            <a class="text-link" href={`/films/#${id}`}>Explore {product.name} <span aria-hidden="true">↗</span></a>
          </article>
        );
      })}
    </div>
    <div class="catalog-invitation">
      <p>From the opening film to the home-field screen, find the format for your team.</p>
      <a class="text-link" href="/films/">Explore all team films <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="spotlight-section" id="spotlights" aria-labelledby="spotlights-title">
    <div class="shell">
      <header class="section-head">
        <div><p class="eyebrow"><span class="dot"></span> 02 / Spotlights</p><h2 id="spotlights-title">Every team has heroes.<br /><em>Meet one.</em></h2></div>
        <p>The athlete who never stops working. The coach who changed their game. Give one person’s story the screen.</p>
      </header>
      <SpotlightFormats />
    </div>
  </section>

  <Poster kicker="03 / Custom season posters" />

  {premiere && (
    <section class="section shell premiere-teaser" aria-labelledby="premiere-title">
      <div>
        <p class="eyebrow"><span class="dot"></span> 04 / Premieres</p>
        <h2 id="premiere-title">The night it all <em>comes together.</em></h2>
        <p>We produce the media and run the screening. The team, coaches, and families get to watch their season together.</p>
        <a class="text-link" href={`/premieres/${premiere.id}/`}>Preview Mansfield’s premiere <span aria-hidden="true">↗</span></a>
      </div>
      <a class="premiere-ticket" href={`/premieres/${premiere.id}/`}>
        <span class="eyebrow">Upcoming premiere <span aria-hidden="true">↗</span></span>
        <strong>{premiere.data.title}</strong>
        <span>{date.format(new Date(premiere.data.date + 'T00:00:00Z'))}</span>
      </a>
    </section>
  )}

  <section class="project-section" id="project" aria-labelledby="project-title">
    <div class="shell project-inner">
      <div>
        <p class="eyebrow"><span class="dot"></span> Start a project</p>
        <h2 id="project-title">What’s their <em>story?</em></h2>
      </div>
      <div>
        <p>Tell us about the team, the athlete, or the night you’re planning.</p>
        <p class="draft-label">Inquiry form pending · local prototype</p>
      </div>
    </div>
  </section>
</SiteLayout>
