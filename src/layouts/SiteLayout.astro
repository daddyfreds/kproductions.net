---
import '../styles/site.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Glories. Stories. In Motion',
  description = 'Cinematic season films, custom movie posters, and premiere nights for teams and clubs.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#111210" />
    <link rel="icon" type="image/svg+xml" href="/media/favicon.svg" />
    <title>{title} | K Productions</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead">
      <div class="shell header-inner">
        <a href="/" class="brand" aria-label="K Productions home">
          <img src="/media/logo-light.svg" width="49" height="42" alt="" />
          <span class="brand-signature">Glories. Stories.<br />In Motion</span>
        </a>
        <nav aria-label="Primary">
          <a href="/films/" aria-current={Astro.url.pathname.startsWith('/films/') ? 'page' : undefined}>Films</a>
          <a href="/#posters">Posters</a>
          <a href="/#premieres">Premieres</a>
          <a class="nav-cta" href="/#project">Start a Project <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="shell footer-inner">
        <a href="/" class="brand" aria-label="K Productions home">
          <img src="/media/logo-light.svg" width="49" height="42" alt="" />
          <span class="brand-signature">Glories. Stories.<br />In Motion</span>
        </a>
        <p>© 2026 K Productions</p>
      </div>
    </footer>

    <dialog id="media-viewer" class="media-viewer" aria-labelledby="viewer-title">
      <div class="viewer-bar">
        <h2 id="viewer-title"></h2>
        <button class="viewer-close" type="button" aria-label="Close media viewer">×</button>
      </div>
      <div class="viewer-content"></div>
      <div class="viewer-credits"></div>
      <div class="viewer-footer"></div>
    </dialog>
    <script>
      const viewer = document.querySelector<HTMLDialogElement>('#media-viewer');
      const viewerTitle = viewer?.querySelector<HTMLElement>('#viewer-title');
      const content = viewer?.querySelector<HTMLElement>('.viewer-content');
      const footer = viewer?.querySelector<HTMLElement>('.viewer-footer');
      const credits = viewer?.querySelector<HTMLElement>('.viewer-credits');
      const close = viewer?.querySelector<HTMLButtonElement>('.viewer-close');

      if (viewer && viewerTitle && content && footer && credits && close && typeof viewer.showModal === 'function') {
        let trigger: HTMLAnchorElement | null = null;

        for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-view]')) {
          link.addEventListener('click', (event) => {
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            const { view, title, id, start, year, orientation, product, production, music } = link.dataset;
            if (view === 'film' && !id) return;
            event.preventDefault();
            trigger = link;
            viewerTitle.textContent = [product, title, year].filter(Boolean).join(' · ');
            viewer.dataset.view = view ?? '';
            viewer.dataset.orientation = orientation ?? 'landscape';
            const fallback = document.createElement('a');
            fallback.className = 'text-link';
            fallback.href = link.href;
            fallback.textContent = view === 'film' ? 'Watch on YouTube ↗' : 'Open full-size image ↗';
            footer.append(fallback);

            if (view === 'film') {
              const url = new URL('/embed/' + id, 'https://www.youtube-nocookie.com');
              url.searchParams.set('autoplay', '1');
              if (start) url.searchParams.set('start', start);
              const player = document.createElement('iframe');
              player.src = url.href;
              player.title = title ?? 'YouTube video';
              player.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
              player.allowFullscreen = true;
              player.referrerPolicy = 'strict-origin-when-cross-origin';
              content.append(player);
              for (const credit of [production, music && 'Music ' + music]) {
                if (credit) {
                  const line = document.createElement('p');
                  line.textContent = credit;
                  credits.append(line);
                }
              }
            } else {
              const image = document.createElement('img');
              image.src = link.href;
              image.alt = title ?? 'Poster';
              content.append(image);
              const zoom = document.createElement('button');
              zoom.className = 'text-link';
              zoom.type = 'button';
              zoom.textContent = 'Zoom in';
              zoom.setAttribute('aria-pressed', 'false');
              zoom.addEventListener('click', () => {
                const enlarged = content.classList.toggle('is-enlarged');
                zoom.textContent = enlarged ? 'Zoom out' : 'Zoom in';
                zoom.setAttribute('aria-pressed', String(enlarged));
                if (!enlarged) content.scrollTo(0, 0);
              });
              footer.prepend(zoom);
            }
            viewer.showModal();
            close.focus();
          });
        }

        close.addEventListener('click', () => viewer.close());
        viewer.addEventListener('click', (event) => {
          if (event.target === viewer) viewer.close();
        });
        viewer.addEventListener('close', () => {
          content.replaceChildren();
          content.classList.remove('is-enlarged');
          footer.replaceChildren();
          credits.replaceChildren();
          trigger?.focus();
          trigger = null;
        });
      }
    </script>
  </body>
</html>
